# ── Secrets & environment ─────────────────────────────────────────────────────
# .env.production is intentionally tracked (contains non-sensitive build config)
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage
htmlcov/

# ── Node / JS ────────────────────────────────────────────────────────────────
node_modules/
# cookie-extractor is local-only; frontend/package-lock.json is intentionally tracked (required for npm ci in deploy)
cookie-extractor/package-lock.json

# ── Build output ─────────────────────────────────────────────────────────────
dist/
dist-ssr/

# ── Runtime data ─────────────────────────────────────────────────────────────
*.db
*.log
data/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Project-specific ─────────────────────────────────────────────────────────
.superpowers/
